local function calculateEnemyHealth(player)
	if not player then return 0 end
	local durability = 0
	local dur = player:FindFirstChild("Durability") or (player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Durability"))
	if dur then durability = dur.Value end
	local multiplier = 1
	local ultimates = player:FindFirstChild("ultimatesFolder")
	if ultimates then
		local infernal = ultimates:FindFirstChild("Infernal Health")
		if infernal then
			multiplier = multiplier + 0.15 * (infernal.Value or 0)
		end
	end
	local equippedPets = player:FindFirstChild("equippedPets")
	if equippedPets then
		local petBonus = 0
		for _, child in ipairs(equippedPets:GetChildren()) do
			if child:IsA("ObjectValue") and child.Value then
				local name = string.lower(child.Value.Name)
				if name:match("mighty") and name:match("monster") then
					petBonus = petBonus + 0.5
				end
			end
		end
		multiplier = multiplier + petBonus
	end
	return durability * multiplier
end

local function calculateYourDamage()
	local strength = 0
	local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
	if leaderstats then
		local str = leaderstats:FindFirstChild("Strength")
		if str then strength = str.Value end
	end
	local base = strength * 0.0667
	local multiplier = 1
	local ultimates = LocalPlayer:FindFirstChild("ultimatesFolder")
	if ultimates then
		local demon = ultimates:FindFirstChild("Demon Damage")
		if demon then
			multiplier = multiplier + 0.1 * (demon.Value or 0)
		end
	end
	local equippedPets = LocalPlayer:FindFirstChild("equippedPets")
	if equippedPets then
		local petBonus = 0
		for _, child in ipairs(equippedPets:GetChildren()) do
			if child:IsA("ObjectValue") and child.Value then
				local name = string.lower(child.Value.Name)
				if name:match("wild") and name:match("wizard") then
					petBonus = petBonus + 0.5
				end
			end
		end
		multiplier = multiplier + petBonus
	end
	return base * multiplier
end

local function calculateHits(health, damage)
	if damage <= 0 then return "∞" end
	local hits = math.ceil(health / damage)
	if hits > 100 then return "∞" end
	if hits < 1 then return 1 end
	return hits
end

local function updateAdvancedStats(player)
	if not player then
		enemyHealthLabel.Text = "Enemy Health: N/A"
		yourDamageLabel.Text = "Your Damage: N/A"
		hitsToKillLabel.Text = "Hits to Kill: N/A"
		return
	end
	local health = calculateEnemyHealth(player)
	local damage = calculateYourDamage()
	local hits = calculateHits(health, damage)
	enemyHealthLabel.Text = string.format("Enemy Health: %s (%s)", formatShort(health), formatCommas(health))
	yourDamageLabel.Text = string.format("Your Damage: %s (%s)", formatShort(damage), formatCommas(damage))
	hitsToKillLabel.Text = string.format("Hits to Kill: %s", tostring(hits))
end

