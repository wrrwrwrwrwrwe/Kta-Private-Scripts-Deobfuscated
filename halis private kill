local blacklistPatterns = {}
local blacklistedPlayers = {}

local function trim(text)
    return text:match("^%s*(.-)%s*$")
end

local function parseBlacklist(text)
    blacklistPatterns = {}
    if not text or text == "" then
        return
    end
    for piece in string.gmatch(text, "[^,]+") do
        local value = trim(piece):lower()
        if value ~= "" then
            table.insert(blacklistPatterns, value)
        end
    end
end

local function playerMatchesBlacklist(player)
    if not player then
        return false
    end
    local displayName = (player.DisplayName or ""):lower()
    for _, pattern in ipairs(blacklistPatterns) do
        if pattern ~= "" and string.find(displayName, pattern, 1, true) then
            return true
        end
    end
    return false
end

local function refreshBlacklistedPlayers()
    for player in pairs(blacklistedPlayers) do
        blacklistedPlayers[player] = nil
    end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and playerMatchesBlacklist(player) then
            blacklistedPlayers[player] = true
        end
    end
end

local function hasBlacklistedPlayers()
    for _ in pairs(blacklistedPlayers) do
        return true
    end
    return false
end

