local function estimateEnemyHealth(player)
    if not player then
        return 0
    end
    local durability = player:FindFirstChild("Durability")
    if not durability then
        local leaderstats = player:FindFirstChild("leaderstats")
        if leaderstats then
            durability = leaderstats:FindFirstChild("Durability")
        end
    end
    local durabilityValue = durability and durability.Value or 0
    return durabilityValue * (1 + 0)
end

local function estimateMyDamage()
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    local strength = leaderstats and leaderstats:FindFirstChild("Strength")
    if not strength then
        return 0
    end
    return (strength.Value * 0.0667) * (1 + 0)
end

local function hitsToKill(health, damage)
    if damage <= 0 then
        return "∞"
    end
    local hits = math.ceil(health / damage)
    if hits > 100 then
        return "∞"
    end
    if hits < 1 then
        return 1
    end
    return hits
end

local function updateCombatPreview(player)
    if not player then
        enemyHealthLabel.Text = "Enemy Health: N/A"
        yourDamageLabel.Text = "Your Damage: N/A"
        hitsToKillLabel.Text = "Hits to Kill: N/A"
        return
    end
    local health = estimateEnemyHealth(player)
    local damage = estimateMyDamage()
    local hits = hitsToKill(health, damage)
    enemyHealthLabel.Text = string.format("Enemy Health: %s (%s)", formatShort(health), formatCommas(health))
    yourDamageLabel.Text = string.format("Your Damage: %s (%s)", formatShort(damage), formatCommas(damage))
    hitsToKillLabel.Text = string.format("Hits to Kill: %s", tostring(hits))
end

