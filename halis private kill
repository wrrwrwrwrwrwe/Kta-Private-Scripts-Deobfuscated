            _G.BpAddConn = nil
        end
        if _G.CharAddConn then
            _G.CharAddConn:Disconnect()
            _G.CharAddConn = nil
        end
        if _G.ToolConns then
            for _, connection in pairs(_G.ToolConns) do
                if connection then
                    connection:Disconnect()
                end
            end
            _G.ToolConns = nil
        end
        if LocalPlayer.Character then
            for _, child in pairs(LocalPlayer.Character:GetChildren()) do
                if child:IsA("Tool") then
                    child:SetAttribute("AOvrr", nil)
