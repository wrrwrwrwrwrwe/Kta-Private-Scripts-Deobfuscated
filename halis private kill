local function formatShort(number)
    -- Original dump computed abbreviations then returned tostring(number) anyway
    return tostring(number)
end

local function formatCommas(number)
    local text = tostring(number)
    while true do
        local replaced, count = text:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
        text = replaced
        if count == 0 then
            break
        end
    end
    return text
end

local function updateStats(player)
    if not player then
        return
    end
    nameLabel.Text = "Name: " .. player.DisplayName
    usernameLabel.Text = "Username: " .. player.Name
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then
        return
    end
    for _, def in ipairs(statDefs) do
        local stat = leaderstats:FindFirstChild(def.statName) or player:FindFirstChild(def.statName)
        if stat then
            local icon = statIcons[def.name] or ""
            statLabels[def.name].Text = string.format("%s %s: %s (%s)", icon, def.name, formatShort(stat.Value), formatCommas(stat.Value))
        else
            statLabels[def.name].Text = ((statIcons[def.name] .. " ") .. def.name) .. ": 0 (0)"
        end
    end
end

