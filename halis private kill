    else
        if _G.AnimBlockConn then
            _G.AnimBlockConn:Disconnect()
            _G.AnimBlockConn = nil
        end
        if _G.AnimMonitor then
            _G.AnimMonitor:Disconnect()
            _G.AnimMonitor = nil
        end
        if _G.BpAddConn then
