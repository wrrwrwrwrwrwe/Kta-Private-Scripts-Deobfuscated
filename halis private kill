local BLOCKED_ANIM_IDS = {
    ["rbxassetid://3638729053"] = true,
    ["rbxassetid://3638767427"] = true,
}

local function isPunchAnimation(track)
    if not track.Animation then
        return false
    end
    local name = track.Name:lower()
    if BLOCKED_ANIM_IDS[track.Animation.AnimationId] then
        return true
    end
    return name:match("punch") or name:match("attack") or name:match("right")
end

local function stopPunchTracks(character)
    local humanoid = character and character:FindFirstChild("Humanoid")
    if not humanoid then
        return
    end
    for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
        if isPunchAnimation(track) then
            track:Stop()
        end
    end
    if not _G.AnimBlockConn then
        _G.AnimBlockConn = humanoid.AnimationPlayed:Connect(function(track)
            if isPunchAnimation(track) then
                track:Stop()
            end
        end)
    end
end

local function hookPunchTool(tool)
    if not tool then
        return
    end
    local isPunchTool = tool.Name == "Punch" or tool.Name:match("Attack") or tool.Name:match("Right")
    if not isPunchTool then
        return
    end
    if tool:GetAttribute("AOvrr") then
        return
    end
    tool:SetAttribute("AOvrr", true)
    local connection = tool.Activated:Connect(function()
        task.wait(0.05)
        local humanoid = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
        if not humanoid then
            return
        end
        for _, track in pairs(humanoid:GetPlayingAnimationTracks()) do
            if isPunchAnimation(track) then
                track:Stop()
            end
        end
    end)
    _G.ToolConns = _G.ToolConns or {}
    _G.ToolConns[tool] = connection
end

