local function formatSigned(n)
    local abs = math.abs(n)
    local sign = n < 0 and "-" or ""
    if abs >= 1e15 then
        return sign .. string.format("%.2fQa", abs / 1e15)
    elseif abs >= 1e12 then
        return sign .. string.format("%.2fT", abs / 1e12)
    elseif abs >= 1e9 then
        return sign .. string.format("%.2fB", abs / 1e9)
    elseif abs >= 1e6 then
        return sign .. string.format("%.2fM", abs / 1e6)
    elseif abs >= 1e3 then
        return sign .. string.format("%.2fK", abs / 1e3)
    end
    return sign .. string.format("%.2f", abs)
end

