local function doRebirthCycle()
    local requiredStrength = 5000 + rebirths.Value * 2550
    while isRebirthing and requiredStrength > LocalPlayer.leaderstats.Strength.Value do
        local maxReps = LocalPlayer.MembershipType ~= Enum.MembershipType.Premium and 14 or 8
        local count = 0
        local hasStrength = false
        while true do
            count = count + 1
            if (hasStrength and count > maxReps) or (not hasStrength and count > maxReps) then
                break
            end
            muscleEvent:FireServer("rep")
        end
        task.wait(0.02)
    end
    if isRebirthing and requiredStrength <= LocalPlayer.leaderstats.Strength.Value then
        equipPet("Tribal Overlord")
        task.wait(0.25)
        local oldRebirths = rebirths.Value
        repeat
            ReplicatedStorage.rEvents.rebirthRemote:InvokeServer("rebirthRequest")
            task.wait(0.05)
        until rebirths.Value > oldRebirths or not isRebirthing
    end
end

local function rebirthLoop()
    while isRebirthing do
        equipPet("Swift Samurai")
        doRebirthCycle()
        task.wait(0.5)
    end
end

