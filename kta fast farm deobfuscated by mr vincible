                    avgDurabilityPaceLabel.Text = "Average Durability Pace: " .. formatSigned(dRate * 3600) .. "/Hour | " .. formatSigned(dRate * 86400) .. "/Day | " .. formatSigned(dRate * 604800) .. "/Week"
                end
            end
        elseif wasFarming then
            wasFarming = false
            farmElapsed = farmElapsed + (now - farmSessionStart)
            farmTimeLabel.Text = string.format("%dd %dh %dm %ds - Fast Rep Stopped", math.floor(farmElapsed / 86400), math.floor(farmElapsed % 86400 / 3600), math.floor(farmElapsed % 3600 / 60), math.floor(farmElapsed % 60))
