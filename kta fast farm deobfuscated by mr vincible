local initialStrength = strength.Value
local initialDurability = durability.Value

task.spawn(function()
    local lastSampleTime = tick()
    while true do
        local now = tick()
        local currentStrength = strength.Value
        local currentDurability = durability.Value
        strengthLabel.Text = "Strength: " .. formatSigned(currentStrength) .. " | Gained: " .. formatSigned(currentStrength - initialStrength)
        durabilityLabel.Text = "Durability: " .. formatSigned(currentDurability) .. " | Gained: " .. formatSigned(currentDurability - initialDurability)
        if isFarming then
            if not wasFarming then
                wasFarming = true
                farmSessionStart = now
                strengthSamples = {}
                durabilitySamples = {}
            end
            local totalElapsed = farmElapsed + (now - farmSessionStart)
            local d = math.floor(totalElapsed / 86400)
            local h = math.floor(totalElapsed % 86400 / 3600)
            local m = math.floor(totalElapsed % 3600 / 60)
            local s = math.floor(totalElapsed % 60)
            farmTimeLabel.Text = string.format("%dd %dh %dm %ds - Fast Rep Running", d, h, m, s)
            farmTimeLabel.TextColor3 = Color3.fromRGB(50, 255, 50)
            table.insert(strengthSamples, {time = now, value = currentStrength})
            table.insert(durabilitySamples, {time = now, value = currentDurability})
            while #strengthSamples > 0 and now - strengthSamples[1].time > 10 do
                table.remove(strengthSamples, 1)
            end
            while #durabilitySamples > 0 and now - durabilitySamples[1].time > 10 do
                table.remove(durabilitySamples, 1)
            end
            if now - lastSampleTime >= 10 then
                lastSampleTime = now
                if #strengthSamples >= 2 then
                    local rate = (strengthSamples[#strengthSamples].value - strengthSamples[1].value) / 10
                    strengthPaceLabel.Text = "Strength Pace: " .. formatSigned(rate * 3600) .. "/Hour | " .. formatSigned(rate * 86400) .. "/Day | " .. formatSigned(rate * 604800) .. "/Week"
                end
                if #durabilitySamples >= 2 then
                    local rate = (durabilitySamples[#durabilitySamples].value - durabilitySamples[1].value) / 10
                    durabilityPaceLabel.Text = "Durability Pace: " .. formatSigned(rate * 3600) .. "/Hour | " .. formatSigned(rate * 86400) .. "/Day | " .. formatSigned(rate * 604800) .. "/Week"
                end
                if totalElapsed > 0 then
                    local sRate = (currentStrength - initialStrength) / totalElapsed
                    avgStrengthPaceLabel.Text = "Average Strength Pace: " .. formatSigned(sRate * 3600) .. "/Hour | " .. formatSigned(sRate * 86400) .. "/Day | " .. formatSigned(sRate * 604800) .. "/Week"
