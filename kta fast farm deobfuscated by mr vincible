local function updateTimeLabel()
    local elapsed = isRebirthing and (tick() - rebirthStartTime) or 0
    local d = math.floor(elapsed / 86400)
    local h = math.floor(elapsed % 86400 / 3600)
    local m = math.floor(elapsed % 3600 / 60)
    local s = math.floor(elapsed % 60)
    timeLabel.Text = string.format("%dd %dh %dm %ds - %s", d, h, m, s, isRebirthing and "Rebirthing" or "Paused")
    timeLabel.TextColor3 = isRebirthing and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(255, 50, 50)
end

local lastPaceTime = tick()
local lastPaceRebirths = rebirths.Value
local hourPaces = {}
local dayPaces = {}
local weekPaces = {}
local paceCounter = 0

local function calculatePace()
    paceCounter = paceCounter + 1
    if paceCounter < 2 then
        lastPaceTime = tick()
        lastPaceRebirths = rebirths.Value
        return
    end
    local now = tick()
    local gained = rebirths.Value - lastPaceRebirths
    if gained > 0 then
        local secondsPerRebirth = (now - lastPaceTime) / gained
        local perHour = 3600 / secondsPerRebirth
        local perDay = 86400 / secondsPerRebirth
        local perWeek = 604800 / secondsPerRebirth
        paceLabel.Text = string.format("Pace: %s / Hour | %s / Day | %s / Week", formatNumber(perHour), formatNumber(perDay), formatNumber(perWeek))
        table.insert(hourPaces, perHour)
        table.insert(dayPaces, perDay)
        table.insert(weekPaces, perWeek)
        if #hourPaces > 20 then
            table.remove(hourPaces, 1)
            table.remove(dayPaces, 1)
            table.remove(weekPaces, 1)
        end
        local function average(t)
            local sum = 0
            for _, v in ipairs(t) do
                sum = sum + v
            end
            return #t > 0 and sum / #t or 0
        end
        avgPaceLabel.Text = string.format("Average Pace: %s / Hour | %s / Day | %s / Week", formatNumber(average(hourPaces)), formatNumber(average(dayPaces)), formatNumber(average(weekPaces)))
    end
end

