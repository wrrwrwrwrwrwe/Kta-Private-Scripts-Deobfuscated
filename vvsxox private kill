    _G.deathRingEnabled = state
    if state then
        if not _G.deathRingConnection then
            _G.deathRingConnection = RunService.Heartbeat:Connect(function()
                updateRingPosition()
                local c = LocalPlayer.Character
                local rp = c and c:FindFirstChild("HumanoidRootPart")
                if not rp then return end

                for _, plr in ipairs(Players:GetPlayers()) do
                    if plr ~= LocalPlayer and not table.find(_G.whitelistedPlayers, plr.Name) then
                        local targetChar = plr.Character
                        if targetChar and targetChar:FindFirstChild("Humanoid") and targetChar.Humanoid.Health > 0 then
                            local root = targetChar:FindFirstChild("HumanoidRootPart")
                            if root and (rp.Position - root.Position).Magnitude <= (_G.deathRingRange or 20) then
                                local right = c:FindFirstChild("RightHand")
                                local left = c:FindFirstChild("LeftHand")
                                if right and left then
                                    pcall(function()
                                        firetouchinterest(right, root, 1)
                                        firetouchinterest(left, root, 1)
                                        firetouchinterest(right, root, 0)
                                        firetouchinterest(left, root, 0)
                                        LocalPlayer.muscleEvent:FireServer("punch", "rightHand")
                                        LocalPlayer.muscleEvent:FireServer("punch", "leftHand")
                                    end)
                                end
                            end
                        end
                    end
                end
            end)
        end
    else
        if _G.deathRingConnection then
            _G.deathRingConnection:Disconnect()
            _G.deathRingConnection = nil
        end
    end
end)

