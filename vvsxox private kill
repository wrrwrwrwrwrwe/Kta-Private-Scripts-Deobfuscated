local partSize = 2048
local totalDistance = 50000
local startPosition = Vector3.new(-2, -9.5, -2)
local numberOfParts = math.ceil(totalDistance / partSize)

local function createWaterParts()
    for x = 0, numberOfParts - 1 do
        for z = 0, numberOfParts - 1 do
            local offsets = {
                Vector3.new(x * partSize, 0, z * partSize),
                Vector3.new(-x * partSize, 0, z * partSize),
                Vector3.new(-x * partSize, 0, -z * partSize),
                Vector3.new(x * partSize, 0, -z * partSize)
            }
            for i, offset in ipairs(offsets) do
                local part = Instance.new("Part")
                part.Size = Vector3.new(partSize, 1, partSize)
                part.Position = startPosition + offset
                part.Anchored = true
                part.Transparency = 1
                part.CanCollide = true
                part.Name = "WaterPart_" .. x .. "_" .. z .. "_" .. i
                part.Parent = workspace
                table.insert(waterParts, part)
            end
        end
    end
end

local function setWaterCollision(canCollide)
    for _, part in ipairs(waterParts) do
        if part and part.Parent then
            part.CanCollide = canCollide
        end
    end
end

MainTab:AddSwitch("Walk On Water", function(state)
    if state then
        if #waterParts == 0 then
            createWaterParts()
        else
            setWaterCollision(true)
        end
    else
        setWaterCollision(false)
    end
end)


